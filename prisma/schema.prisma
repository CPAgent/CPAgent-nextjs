// Prisma Schema for CPAgent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  phone        String?
  profileImage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  receipts     Receipt[]
  budget       Budget?
}

model Transaction {
  id              String    @id @default(uuid())
  userId          String
  date            DateTime
  merchant        String
  category        String
  amount          Int
  type            String    @default("expense")
  paymentMethod   String
  cardLastFour    String?
  memo            String?
  receiptUrl      String?
  locationAddress String?
  latitude        Float?
  longitude       Float?
  tags            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt         Receipt?

  @@index([userId])
  @@index([date])
  @@index([category])
}

model Receipt {
  id            String       @id @default(uuid())
  userId        String
  url           String
  thumbnail     String?
  transactionId String?      @unique
  ocrData       String?
  uploadedAt    DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String   @unique
  monthly    Int
  categories String
  alerts     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}